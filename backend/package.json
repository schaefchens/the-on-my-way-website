{
  "name": "@omw/backend",
  "version": "0.1.0",
  "private": true,
  "description": "On My Way backend: WhatsApp capture, media pipeline, static site generator, SFTP publisher",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "TSX_DISABLE_CACHE=1 node --conditions=@omw/source --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "cli:dev": "TSX_DISABLE_CACHE=1 node --conditions=@omw/source --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:apache": "vitest run --config vitest.apache.config.ts",
    "docker:check": "docker build --check -f Dockerfile ..",
    "docker:build": "docker build -f Dockerfile -t omw-backend .."
  },
  "dependencies": {
    "@omw/contracts": "workspace:*",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "markdown-it": "15.0.3",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "ssh2": "1.17.0",
    "ssh2-sftp-client": "12.1.1",
    "thumbhash": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/ssh2": "1.15.6",
    "@types/ssh2-sftp-client": "9.0.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
