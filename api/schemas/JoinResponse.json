{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/JoinResponse.json",
  "title": "JoinResponse",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "invalid",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ended",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "locked",
            "restoring",
            "notice_missing",
            "too_many_pending",
            "store"
          ],
          "type": "string"
        },
        "status": {
          "const": "unavailable",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "deviceKey": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "handoff": {
          "enum": [
            "/_/h/",
            "/"
          ],
          "type": "string"
        },
        "session": {
          "pattern": "^[a-z2-7]{12}\\.[a-z2-7]{8}\\.[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "status": {
          "const": "active",
          "type": "string"
        }
      },
      "required": [
        "status",
        "handoff"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "deviceKey": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "pollAfterMs": {
          "maximum": 60000,
          "minimum": 500,
          "type": "integer"
        },
        "status": {
          "const": "activating",
          "type": "string"
        }
      },
      "required": [
        "status",
        "pollAfterMs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "deviceKey": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "pollAfterMs": {
          "maximum": 60000,
          "minimum": 500,
          "type": "integer"
        },
        "status": {
          "const": "pending",
          "type": "string"
        }
      },
      "required": [
        "status",
        "pollAfterMs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "notice": {
          "additionalProperties": false,
          "properties": {
            "controller": {
              "additionalProperties": false,
              "properties": {
                "address": {
                  "maxLength": 300,
                  "type": "string"
                },
                "email": {
                  "format": "email",
                  "maxLength": 254,
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "type": "object"
            },
            "publishedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "texts": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "audience": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "collected": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "intro": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "purpose": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "retention": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "rights": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "intro",
                  "collected",
                  "audience",
                  "purpose",
                  "retention",
                  "rights"
                ],
                "type": "object"
              },
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "de",
                  "en",
                  "ar"
                ],
                "type": "string"
              },
              "type": "object"
            },
            "version": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "controller",
            "texts",
            "version",
            "publishedAt"
          ],
          "type": "object"
        },
        "status": {
          "const": "consent_outdated",
          "type": "string"
        }
      },
      "required": [
        "status",
        "notice"
      ],
      "type": "object"
    }
  ]
}
