{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/SettingsPatch.json",
  "title": "SettingsPatch",
  "additionalProperties": false,
  "properties": {
    "alerts.email": {
      "anyOf": [
        {
          "format": "email",
          "maxLength": 254,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "alerts.heartbeat_stale_minutes": {
      "maximum": 10080,
      "minimum": 1,
      "type": "integer"
    },
    "alerts.ntfy_url": {
      "anyOf": [
        {
          "pattern": "^https?:\\/\\/[^\\s/?#]+(?:[/?#]\\S*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ingest.on_revoke": {
      "enum": [
        "hide",
        "keep"
      ],
      "type": "string"
    },
    "publish.delay_minutes": {
      "maximum": 525600,
      "minimum": 0,
      "type": "integer"
    },
    "publish.mode": {
      "enum": [
        "instant",
        "delayed",
        "review"
      ],
      "type": "string"
    },
    "site.author": {
      "anyOf": [
        {
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Z}](?:[^\\p{Cc}]*[^\\p{Cc}\\p{Z}])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "site.avatar": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "focus": {
              "additionalProperties": false,
              "properties": {
                "x": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "y": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "type": "object"
            },
            "sourceKey": {
              "maxLength": 160,
              "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "sourceKey"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "site.default_locale": {
      "enum": [
        "de",
        "en",
        "ar"
      ],
      "type": "string"
    },
    "site.indexable": {
      "type": "boolean"
    },
    "site.intro": {
      "anyOf": [
        {
          "additionalProperties": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[^\\p{Cc}\\p{Z}](?:(?:[^\\p{Cc}]|\\n)*[^\\p{Cc}\\p{Z}])?$",
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "de",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "site.locales": {
      "items": {
        "enum": [
          "de",
          "en",
          "ar"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "site.title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "timezone.current": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_+\\-/]*$",
      "type": "string"
    }
  },
  "type": "object"
}
