{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/StoreListingUpload.json",
  "title": "StoreListingUpload",
  "additionalProperties": false,
  "properties": {
    "epoch": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "listing": {
      "additionalProperties": false,
      "properties": {
        "handoffs": {
          "items": {
            "pattern": "^[a-z2-7]{8}$",
            "type": "string"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "locked": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "items": {
            "pattern": "^s\\/[a-z2-7]{12}\\/[a-z2-7]{8}\\.[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "strays": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "tombstones": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "maxLength": 1000,
                "type": "string"
              },
              "path": {
                "pattern": "^t\\/[a-z2-7]{12}(?:\\.[a-z2-7]{8})?$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "type": "object"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "marker",
        "locked",
        "sessions",
        "handoffs",
        "tombstones",
        "strays"
      ],
      "type": "object"
    }
  },
  "required": [
    "epoch",
    "listing"
  ],
  "type": "object"
}
