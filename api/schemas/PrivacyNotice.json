{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/PrivacyNotice.json",
  "title": "PrivacyNotice",
  "additionalProperties": false,
  "properties": {
    "controller": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 300,
          "type": "string"
        },
        "email": {
          "format": "email",
          "maxLength": 254,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "type": "object"
    },
    "texts": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "collected": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "intro": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "purpose": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "retention": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "rights": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title",
          "intro",
          "collected",
          "audience",
          "purpose",
          "retention",
          "rights"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "de",
          "en",
          "ar"
        ],
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "controller",
    "texts"
  ],
  "type": "object"
}
