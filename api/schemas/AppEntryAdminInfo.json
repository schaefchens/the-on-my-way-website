{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/AppEntryAdminInfo.json",
  "title": "AppEntryAdminInfo",
  "additionalProperties": false,
  "properties": {
    "appVisibility": {
      "anyOf": [
        {
          "enum": [
            "pending",
            "hidden"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "clamped": {
      "type": "boolean"
    },
    "heldBack": {
      "type": "boolean"
    },
    "originalArchived": {
      "type": "boolean"
    },
    "phone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "name": {
          "maxLength": 100,
          "type": "string"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "revoked"
      ],
      "type": "object"
    },
    "receivedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "rejectReason": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceKey": {
      "maxLength": 160,
      "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "receiving",
        "uploaded",
        "fetching",
        "archived",
        "withdrawn",
        "rejected"
      ],
      "type": "string"
    }
  },
  "required": [
    "sourceKey",
    "state",
    "phone",
    "receivedAt",
    "clamped",
    "heldBack",
    "appVisibility",
    "originalArchived",
    "rejectReason"
  ],
  "type": "object"
}
