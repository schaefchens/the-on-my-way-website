{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/PrivacyNoticeDraft.json",
  "title": "PrivacyNoticeDraft",
  "additionalProperties": false,
  "properties": {
    "controller": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 300,
          "type": "string"
        },
        "email": {
          "maxLength": 254,
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "type": "object"
    },
    "texts": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "maxLength": 4000,
            "type": "string"
          },
          "collected": {
            "maxLength": 4000,
            "type": "string"
          },
          "intro": {
            "maxLength": 4000,
            "type": "string"
          },
          "purpose": {
            "maxLength": 4000,
            "type": "string"
          },
          "retention": {
            "maxLength": 4000,
            "type": "string"
          },
          "rights": {
            "maxLength": 4000,
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "de",
          "en",
          "ar"
        ],
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "controller",
    "texts"
  ],
  "type": "object"
}
