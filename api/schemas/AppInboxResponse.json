                    },
                    "role": {
                      "enum": [
                        "media",
                        "preview",
                        "original"
                      ],
                      "type": "string"
                    },
                    "sha256Hex": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "mimetype",
                    "bytes",
                    "sha256Hex"
