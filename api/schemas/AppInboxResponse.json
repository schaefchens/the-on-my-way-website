                "mimetype": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "media",
                    "preview",
                    "original"
                  ],
                  "type": "string"
                },
                "sha256Hex": {
                  "pattern": "^[0-9a-f]{64}$",
