              "entryId",
              "source",
              "kind",
              "occurredAt",
              "tz",
              "files",
              "client"
            ],
            "type": "object"
          },
          "entryId": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "files": {
            "items": {
              "additionalProperties": false,
