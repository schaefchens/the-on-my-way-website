{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/AppInboxResponse.json",
  "title": "AppInboxResponse",
  "additionalProperties": false,
  "properties": {
    "hasMore": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "clamped": {
