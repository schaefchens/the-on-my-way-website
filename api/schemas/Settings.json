{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/Settings.json",
  "title": "Settings",
  "additionalProperties": false,
  "properties": {
    "alerts.email": {
      "format": "email",
      "maxLength": 254,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
    },
    "alerts.heartbeat_stale_minutes": {
      "maximum": 10080,
      "minimum": 1,
      "type": "integer"
    },
    "alerts.ntfy_url": {
      "pattern": "^https?:\\/\\/[^\\s/?#]+(?:[/?#]\\S*)?$",
      "type": "string"
    },
    "ingest.on_revoke": {
      "enum": [
        "hide",
        "keep"
      ],
      "type": "string"
    },
    "publish.delay_minutes": {
      "maximum": 525600,
      "minimum": 0,
      "type": "integer"
    },
    "publish.departure_hold": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxDays": {
          "maximum": 7,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "maxDays"
      ],
      "type": "object"
    },
    "publish.mode": {
      "enum": [
        "instant",
        "delayed",
        "review"
      ],
      "type": "string"
    },
    "publish.mode_since": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "publish.moved_on_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "publish.release_slots": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "times": {
          "items": {
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "enabled",
        "times"
      ],
      "type": "object"
    },
    "site.author": {
      "maxLength": 60,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Z}](?:[^\\p{Cc}]*[^\\p{Cc}\\p{Z}])?$",
      "type": "string"
    },
    "site.avatar": {
      "additionalProperties": false,
      "properties": {
        "focus": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "y": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        },
        "sourceKey": {
          "maxLength": 160,
          "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "sourceKey"
      ],
      "type": "object"
    },
    "site.default_locale": {
      "enum": [
        "de",
        "en",
        "ar"
      ],
      "type": "string"
    },
    "site.here_now": {
      "enum": [
        "city_badge",
        "city",
        "country",
        "none"
      ],
      "type": "string"
    },
    "site.indexable": {
      "type": "boolean"
    },
    "site.intro": {
      "additionalProperties": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[^\\p{Cc}\\p{Z}](?:(?:[^\\p{Cc}]|\\n)*[^\\p{Cc}\\p{Z}])?$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "de",
          "en",
          "ar"
        ],
        "type": "string"
      },
      "type": "object"
    },
    "site.locales": {
      "items": {
        "enum": [
          "de",
          "en",
          "ar"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "site.time_precision": {
      "enum": [
        "exact",
        "part_of_day"
      ],
      "type": "string"
    },
    "site.title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "timezone.current": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_+\\-/]*$",
      "type": "string"
    }
  },
  "required": [
    "publish.mode",
    "publish.mode_since",
    "publish.delay_minutes",
    "publish.release_slots",
    "publish.departure_hold",
    "ingest.on_revoke",
    "timezone.current",
    "site.title",
    "site.locales",
    "site.default_locale",
    "site.indexable",
    "site.here_now",
    "site.time_precision",
    "alerts.heartbeat_stale_minutes"
  ],
  "type": "object"
}
