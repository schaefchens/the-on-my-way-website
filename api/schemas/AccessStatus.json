{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/AccessStatus.json",
  "title": "AccessStatus",
  "additionalProperties": false,
  "properties": {
    "cookieMode": {
      "enum": [
        "headers",
        "co",
        "parent"
      ],
      "type": "string"
    },
    "gateCheck": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "by": {
              "enum": [
                "mac",
                "api"
              ],
              "type": "string"
            },
            "detail": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "enum": [
                "ok",
                "gate_open",
                "store_unverified",
                "error",
                "skipped"
              ],
              "type": "string"
            }
          },
          "required": [
            "at",
            "by",
            "result",
            "detail"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastAppliedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastReconcile": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "deleted": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "imported": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "type": "array"
            },
            "missing": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "did": {
                    "pattern": "^[a-z2-7]{8}$",
                    "type": "string"
                  },
                  "fid": {
                    "pattern": "^[a-z2-7]{12}$",
                    "type": "string"
                  }
                },
                "required": [
                  "fid",
                  "did"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "mode": {
              "enum": [
                "normal",
                "restored_api"
              ],
              "type": "string"
            },
            "orphans": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "did": {
                    "pattern": "^[a-z2-7]{8}$",
                    "type": "string"
                  },
                  "fid": {
                    "pattern": "^[a-z2-7]{12}$",
                    "type": "string"
                  }
                },
                "required": [
                  "fid",
                  "did"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "at",
            "mode",
            "deleted",
            "missing",
            "orphans",
            "imported"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "locked": {
      "type": "boolean"
    },
    "lockedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lockedBy": {
      "anyOf": [
        {
          "enum": [
            "admin",
            "panic",
            "mac"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mismatch": {
      "type": "boolean"
    },
    "noticeVersion": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "oldestPendingOpAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "panicLink": {
      "type": "boolean"
    },
    "pending": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "did": {
            "pattern": "^[a-z2-7]{8}$",
            "type": "string"
          },
          "fid": {
            "pattern": "^[a-z2-7]{12}$",
            "type": "string"
          },
          "label": {
            "maxLength": 60,
            "type": "string"
          },
          "name": {
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[^\\p{Cc}\\p{Z}](?:[^\\p{Cc}]*[^\\p{Cc}\\p{Z}])?$",
            "type": "string"
          }
        },
        "required": [
          "did",
          "fid",
          "name",
          "label",
          "createdAt"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "type": "array"
    },
    "pendingDevices": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "pendingOps": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "restoring": {
      "type": "boolean"
    },
    "siteOrigin": {
      "anyOf": [
        {
          "pattern": "^https?:\\/\\/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\\d{1,5})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "storeId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "storeProofAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "unreadNotices": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "writer": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "direct",
            "sftp",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "blocked",
        "error"
      ],
      "type": "object"
    }
  },
  "required": [
    "locked",
    "lockedAt",
    "lockedBy",
    "pendingDevices",
    "pendingOps",
    "oldestPendingOpAt",
    "writer",
    "restoring",
    "mismatch",
    "unreadNotices",
    "noticeVersion",
    "panicLink",
    "siteOrigin",
    "cookieMode",
    "lastReconcile",
    "lastAppliedAt",
    "storeId",
    "storeProofAt",
    "gateCheck",
    "pending"
  ],
  "type": "object"
}
