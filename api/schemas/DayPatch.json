{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/DayPatch.json",
  "title": "DayPatch",
  "additionalProperties": false,
  "properties": {
    "countryCode": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverSourceKey": {
      "anyOf": [
        {
          "maxLength": 160,
          "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ifUpdatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "lng": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "origLocale": {
      "anyOf": [
        {
          "enum": [
            "de",
            "en",
            "ar"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "placeName": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "additionalProperties": {
            "maxLength": 20000,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "de",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "additionalProperties": {
            "maxLength": 20000,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "de",
              "en",
              "ar"
            ],
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "tz": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_+\\-/]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object"
}
