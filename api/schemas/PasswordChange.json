{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/PasswordChange.json",
  "title": "PasswordChange",
  "additionalProperties": false,
  "properties": {
    "currentPassword": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "newPassword": {
      "maxLength": 4096,
      "minLength": 12,
      "type": "string"
    },
    "revokeAppTokens": {
      "type": "boolean"
    }
  },
  "required": [
    "currentPassword",
    "newPassword",
    "revokeAppTokens"
  ],
  "type": "object"
}
