{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/DayListResponse.json",
  "title": "DayListResponse",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "changeSeq": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "counts": {
            "additionalProperties": false,
            "properties": {
              "captures": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "hidden": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "pending": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "posts": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "public": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "captures",
              "posts",
              "public",
              "hidden",
              "pending"
            ],
            "type": "object"
          },
          "coverPreviewUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverSourceKey": {
            "anyOf": [
              {
                "maxLength": 160,
                "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "day": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "countryCode": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Z]{2}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "coverSourceKey": {
                    "anyOf": [
                      {
                        "maxLength": 160,
                        "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lat": {
                    "anyOf": [
                      {
                        "maximum": 90,
                        "minimum": -90,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lng": {
                    "anyOf": [
                      {
                        "maximum": 180,
                        "minimum": -180,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "localDate": {
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "type": "string"
                  },
                  "origLocale": {
                    "anyOf": [
                      {
                        "enum": [
                          "de",
                          "en",
                          "ar"
                        ],
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "placeName": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "summary": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "maxLength": 20000,
                          "type": "string"
                        },
                        "propertyNames": {
                          "enum": [
                            "de",
                            "en",
                            "ar"
                          ],
                          "type": "string"
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "maxLength": 20000,
                          "type": "string"
                        },
                        "propertyNames": {
                          "enum": [
                            "de",
                            "en",
                            "ar"
                          ],
                          "type": "string"
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tz": {
                    "anyOf": [
                      {
                        "maxLength": 64,
                        "minLength": 1,
                        "pattern": "^[A-Za-z][A-Za-z0-9_+\\-/]*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "updatedAt": {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "type": "string"
                  }
                },
                "required": [
                  "localDate",
                  "updatedAt"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "firstAt": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastAt": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "localDate": {
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "type": "string"
          },
          "trip": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "localDate",
          "day",
          "counts",
          "firstAt",
          "lastAt",
          "coverSourceKey",
          "coverPreviewUrl",
          "trip",
          "changeSeq"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "type": "object"
}
