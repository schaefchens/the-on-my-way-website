{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/AppEntryState.json",
  "title": "AppEntryState",
  "additionalProperties": false,
  "properties": {
    "backendLastSeenAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "chunk": {
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "minBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "minBytes",
        "maxBytes"
      ],
      "type": "object"
    },
    "entryId": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "heldBack": {
      "type": "boolean"
    },
    "occurredAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "publish": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "publishAt": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "enum": [
                "live",
                "publishing",
                "not_public"
              ],
              "type": "string"
            },
            "visibility": {
              "enum": [
                "public",
                "hidden",
                "pending"
              ],
              "type": "string"
            }
          },
          "required": [
            "visibility",
            "state",
            "publishAt"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "rejectReason": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceKey": {
      "maxLength": 160,
      "pattern": "^[a-z]+:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "receiving",
        "uploaded",
        "fetching",
        "archived",
        "withdrawn",
        "rejected"
      ],
      "type": "string"
    },
    "uploads": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "bytes": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "committed": {
            "type": "boolean"
          },
          "offset": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "enum": [
              "media",
              "preview",
              "original"
            ],
            "type": "string"
          },
          "uploadId": {
            "pattern": "^u_[A-Za-z0-9_-]{16,64}$",
            "type": "string"
          }
        },
        "required": [
          "uploadId",
          "role",
          "bytes",
          "offset",
          "committed"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "entryId",
    "sourceKey",
    "state",
    "occurredAt",
    "receivedAt",
    "heldBack",
    "uploads",
    "chunk",
    "backendLastSeenAt",
    "publish"
  ],
  "type": "object"
}
