{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omw.invalid/schemas/MeHelloResponse.json",
  "title": "MeHelloResponse",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ended",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "locked",
            "restoring",
            "notice_missing",
            "too_many_pending",
            "store"
          ],
          "type": "string"
        },
        "status": {
          "const": "unavailable",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "device": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[a-z2-7]{8}$",
              "type": "string"
            },
            "label": {
              "maxLength": 60,
              "type": "string"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "type": "object"
        },
        "follower": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 60,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Z}](?:[^\\p{Cc}]*[^\\p{Cc}\\p{Z}])?$",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "notice": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "version": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "required"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "active",
          "type": "string"
        }
      },
      "required": [
        "status",
        "follower",
        "device",
        "notice"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "notice": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "version": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "required"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "pending",
          "type": "string"
        }
      },
      "required": [
        "status",
        "notice"
      ],
      "type": "object"
    }
  ]
}
