# On My Way API configuration. Copy to api/.env and adjust (scripts/deploy-api.ts creates the
# live .env on the first deploy and never overwrites it afterwards).
# Real environment variables take precedence over this file. Values are read literally.
# Relative paths resolve against the api/ directory.

# production | development | test
APP_ENV=production

# true adds exception details to 5xx JSON errors. Never enable in production.
APP_DEBUG=false

# Local http development only: the admin session cookie without the Secure/__Host- prefix
# (omw_dev_session) on PHP's built-in server for loopback clients. Refused unless
# APP_ENV=development; see api/README.md.
# DEV_INSECURE_COOKIE=false

# Public base URL of this API (used by the admin doctor's HTTP self-check), e.g. https://api.example.org
# APP_URL=

# URL prefix when the API is not at the web root (e.g. /omw). Auto-detected when unset.
# Only for API-only setups: the admin PWA (built with base /admin/, API at /api/v1/admin) and its
# __Host- session cookie (which requires Path=/) need the API at the ROOT of its (sub)domain,
# e.g. https://api.example.org/. Use a subdomain rather than a sub-path when you want the admin.
# BASE_PATH=

# Origin of the static site (CORS for future public endpoints), e.g. https://www.example.org
# SITE_ORIGIN=

# Writable data directory (database, previews, backups, logs).
# VAR_DIR=var

# SQLite database file (default: VAR_DIR/app.sqlite).
# DB_PATH=var/app.sqlite

# WAL | DELETE. Use DELETE on NFS-backed hosting where WAL fails (the doctor tells you).
DB_JOURNAL_MODE=WAL

# debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=info

# Log file (rotated daily, 14 days kept; default: VAR_DIR/logs/app.log) or php://stderr.
# LOG_PATH=var/logs/app.log

# Admin session lifetime in days (sliding).
# SESSION_DAYS=30

# Web-cron secret for GET|POST /api/v1/cron (header X-Cron-Key or ?key=); at least 24 characters.
# Leave empty to disable the endpoint (when bin/cron.php runs from a real cron).
# CRON_KEY=

# Alerts. Recipients and the ntfy topic URL are settings in the admin (alerts.email, alerts.ntfy_url).
# E-mail transport via Symfony Mailer (https://symfony.com/doc/current/mailer.html#transport-setup),
# e.g. smtp://user:pass@smtp.example.com:587 or native://default (PHP's sendmail_path).
# MAIL_DSN=
# MAIL_FROM="On My Way <alerts@example.com>"
# Access token for a protected ntfy topic (sent as Bearer), and the ntfy server it belongs to
# (default https://ntfy.sh). The token is sent ONLY when alerts.ntfy_url is on NTFY_SERVER's origin
# (scheme, host and port); alerts to any other server go out without it. In production the API
# refuses alert URLs that point to loopback/private/link-local/CGNAT/unique-local addresses.
# NTFY_TOKEN=
# NTFY_SERVER=https://ntfy.sh
# Re-send open alerts every N minutes; publish_failing after N consecutive failed deploys.
# ALERT_REPEAT_MINUTES=60
# PUBLISH_FAIL_THRESHOLD=3

# Nightly backups (VACUUM INTO var/backups): keep N, create after this local hour (timezone.current).
# BACKUP_KEEP=14
# BACKUP_HOUR=3

# Traveler app inbox (app-plan §3.6; api/README.md "Traveler app"). Disk budget of var/app-inbox:
# at most ~10 % of the account quota (a full quota takes SQLite, the admin and the sync down).
# APP_INBOX_MAX_BYTES=1073741824
# Concurrent chunk uploads + backend downloads (PHP workers - 2, at least 1).
# APP_TRANSFER_SLOTS=1
# Largest chunk announced to the phone (262144..8388608; never above post_max_size).
# APP_CHUNK_MAX_BYTES=8388608
