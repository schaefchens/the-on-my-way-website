{
  "name": "@omw/admin",
  "version": "0.1.0",
  "private": true,
  "description": "On My Way admin PWA (served by the PHP API at /admin/)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "icons": "TSX_DISABLE_CACHE=1 node --import tsx scripts/make-icons.ts",
    "i18n:extract": "lingui extract --clean",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:stack": "playwright test -c e2e/playwright.stack.config.ts",
    "mock-api": "TSX_DISABLE_CACHE=1 node --conditions=@omw/source --import tsx e2e/mock/server.ts --port 51750",
    "shots": "TSX_DISABLE_CACHE=1 node --import tsx e2e/shots.ts"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@omw/contracts": "workspace:*",
    "@omw/ui": "workspace:*",
    "@tanstack/query-async-storage-persister": "5.108.1",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-query-persist-client": "5.108.1",
    "@tanstack/react-router": "1.170.46",
    "idb-keyval": "6.3.0",
    "markdown-it": "15.0.3",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
