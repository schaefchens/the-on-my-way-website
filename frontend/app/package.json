{
  "name": "@omw/app",
  "version": "0.1.0",
  "private": true,
  "description": "On My Way traveler app (Expo SDK 58, React Native, Android first). No build script on purpose: `pnpm -r build` stays web-only.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run && jest",
    "i18n:extract": "lingui extract --clean",
    "tokens": "TSX_DISABLE_CACHE=1 node --import tsx scripts/sync-tokens.mts",
    "tokens:check": "TSX_DISABLE_CACHE=1 node --import tsx scripts/sync-tokens.mts --check",
    "e2e": "../../scripts/app/with-emulator.sh -- sh -c 'adb reverse tcp:8081 tcp:8081 && ../../.cache/maestro/bin/maestro test --no-ansi --debug-output ../../.cache/logs/maestro --test-output-dir ../../.cache/shots/app/maestro --exclude-tags stack,screens,e2e .maestro'",
    "test:unit": "vitest run",
    "test:rn": "jest"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@omw/contracts": "workspace:*",
    "expo": "58.0.26",
    "expo-audio": "58.0.12",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.14",
    "expo-font": "58.0.12",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-local-authentication": "58.0.3",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-sqlite": "58.0.18",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-video": "58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/metro-transformer": "6.12.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.26",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "react-dom": "19.3.0",
    "test-renderer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
