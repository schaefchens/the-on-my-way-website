{
  "name": "@omw/ui",
  "version": "0.1.0",
  "private": true,
  "description": "On My Way design system: Tailwind v4 theme (dawn/dusk), fonts, motion presets, locale helpers, <Picture>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion.ts",
    "./locale": "./src/locale.ts",
    "./fonts": "./src/fonts.ts",
    "./picture": "./src/picture.tsx",
    "./thumbhash": "./src/thumbhash.ts",
    "./theme": "./src/theme.ts",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "fonts": "TSX_DISABLE_CACHE=1 node --import tsx scripts/build-fonts-css.ts",
    "fonts:check": "TSX_DISABLE_CACHE=1 node --import tsx scripts/build-fonts-css.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playpen-sans": "5.3.0",
    "@fontsource-variable/playpen-sans-arabic": "5.3.0",
    "@fontsource-variable/playpen-sans-hebrew": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/calistoga": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@omw/contracts": "workspace:*",
    "thumbhash": "0.1.1"
  },
  "peerDependencies": {
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
